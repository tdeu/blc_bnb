# ==========================================
# BlockCast Environment Configuration
# BSC Testnet Deployment
# ==========================================
# Copy this file to .env and fill in your values
# See README.md for detailed setup instructions

# ==========================================
# REQUIRED - AI Services
# ==========================================

# Anthropic Claude AI (REQUIRED for AI analysis)
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Perplexity AI (RECOMMENDED for real-time web search)
# Get your key: https://www.perplexity.ai/settings/api
# Students get 24 months free Pro (includes $5/month API credits)
VITE_PERPLEXITY_API_KEY=pplx-your-key-here

# Google Gemini AI (RECOMMENDED for fallback verification)
# Get your key: https://makersuite.google.com/app/apikey
# Used as fallback when Perplexity confidence < 85%
VITE_GEMINI_API_KEY=your-gemini-key-here

# ==========================================
# REQUIRED - Database
# ==========================================

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# REQUIRED - BSC Testnet Deployment
# ==========================================

# Deployer Private Key (for contract deployment)
# This is your MetaMask private key - KEEP IT SECRET!
# Get testnet BNB from: https://testnet.bnbchain.org/faucet-smart
DEPLOYER_PRIVATE_KEY=0x-your-deployer-private-key-here

# Admin Private Key (for automated market resolution)
# Separate key for backend admin operations
VITE_ADMIN_PRIVATE_KEY=0x-your-admin-private-key-here

# ==========================================
# BSC Testnet Contract Addresses
# ==========================================
# These will be filled automatically after deployment
# Run: npm run deploy:tokenomics

# Core Contracts (Update these after deployment)
VITE_ADMIN_MANAGER_ADDRESS=0xF02840CdB0f08E6A88E1ACbd14120b1754ebd9fe
VITE_CAST_TOKEN_ADDRESS=0x8B84B21AC2EB9C37EfaD196d99088Df823567e81
VITE_TREASURY_ADDRESS=0x_UPDATE_AFTER_DEPLOYMENT
VITE_FACTORY_ADDRESS=0x_UPDATE_AFTER_DEPLOYMENT
VITE_BET_NFT_ADDRESS=0x3deC8EA06Cbf76cc2378de3dc367eF29837bE43d
VITE_BUYCAST_ADDRESS=0x45fEE9DAcF3Beb2C0C67dF057D068c0003C53B79

# Legacy aliases (for backward compatibility)
CONTRACT_ADMIN_MANAGER=0xF02840CdB0f08E6A88E1ACbd14120b1754ebd9fe
CONTRACT_CAST_TOKEN=0x8B84B21AC2EB9C37EfaD196d99088Df823567e81
CONTRACT_TREASURY=0x_UPDATE_AFTER_DEPLOYMENT
CONTRACT_PREDICTION_MARKET_FACTORY=0x_UPDATE_AFTER_DEPLOYMENT
CONTRACT_BET_NFT=0x3deC8EA06Cbf76cc2378de3dc367eF29837bE43d

# ==========================================
# BSC Network Configuration
# ==========================================

# BSC Testnet RPC (default - fast and reliable)
VITE_JSON_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# BSC Testnet Explorer
VITE_BLOCK_EXPLORER=https://testnet.bscscan.com

# Chain ID (BSC Testnet = 97)
VITE_CHAIN_ID=97

# ==========================================
# OPTIONAL - External APIs
# ==========================================

# NewsAPI (RECOMMENDED for market verification)
# Get your key: https://newsapi.org/register
VITE_NEWS_API_KEY=your-newsapi-key-here

# ==========================================
# API Configuration
# ==========================================

# Backend Services (Local Development)
VITE_AI_PROXY_URL=http://localhost:3001
VITE_MONITOR_URL=http://localhost:3002
VITE_EVIDENCE_REVIEW_URL=http://localhost:3003

# ==========================================
# Development Settings
# ==========================================

# Core Application
NODE_ENV=development
VITE_APP_NAME=BlockCast

# Debug & Testing
VITE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false

# ==========================================
# Market Resolution Configuration
# ==========================================

# Final Resolution Executor Mode
# true = DRY-RUN mode (logs actions without executing blockchain transactions)
# false = LIVE mode (executes actual blockchain transactions)
# IMPORTANT: Start with DRY-RUN mode first to test!
FINAL_RESOLUTION_DRY_RUN=true

# Monitor Service Port
MONITOR_PORT=3002

# Resolution Check Intervals (in minutes)
PRELIMINARY_CHECK_INTERVAL=15
FINAL_CHECK_INTERVAL=60

# ==========================================
# Tokenomics Configuration
# ==========================================

# BuyCAST Exchange Rate (1 BNB = 1000 CAST)
VITE_CAST_EXCHANGE_RATE=1000

# Protocol Fee Rate (200 = 2%)
VITE_PROTOCOL_FEE_RATE=200

# Creator Reward (in CAST tokens)
VITE_CREATOR_REWARD=100

# Market Creation Collateral (in BNB)
VITE_MIN_CREATION_COLLATERAL=0.001

# ==========================================
# DEPLOYMENT CHECKLIST
# ==========================================
#
# [ ] 1. Get testnet BNB from faucet
# [ ] 2. Set DEPLOYER_PRIVATE_KEY and VITE_ADMIN_PRIVATE_KEY
# [ ] 3. Configure Supabase (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY)
# [ ] 4. Add AI API keys (ANTHROPIC_API_KEY, VITE_PERPLEXITY_API_KEY)
# [ ] 5. Run: npm run deploy:tokenomics
# [ ] 6. Update VITE_TREASURY_ADDRESS and VITE_FACTORY_ADDRESS
# [ ] 7. Verify contracts on BscScan
# [ ] 8. Test complete flow (buy CAST → create market → bet → resolve)
# [ ] 9. Monitor automatic resolution system
# [ ] 10. Deploy to production!
